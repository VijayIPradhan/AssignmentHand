# Copy to .env and fill in. Never commit .env. Placeholders only below.

# --- Core ---
APP_ENV=production
LOG_LEVEL=INFO
# 32+ random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
# Set true when served over HTTPS (session cookie gets the Secure flag)
COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# --- Database / storage ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://assignmenthand:change-me@db:5432/assignmenthand
STORAGE_BACKEND=local
STORAGE_ROOT=/data/storage
# Delete assignments not touched for N days (0 = keep until the user deletes them)
RETENTION_DAYS=0

# --- Limits ---
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=40
MAX_QUESTIONS_PER_GENERATION=60
RATE_LIMIT_GENERATE_PER_MIN=10
RATE_LIMIT_RENDER_PER_MIN=20

# --- AI provider: anthropic | bedrock | openai_compatible | none ---
LLM_PROVIDER=bedrock
LLM_EFFORT=high
LLM_TIMEOUT_S=300

# Anthropic API (LLM_PROVIDER=anthropic)
#LLM_MODEL=claude-opus-5-5
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_FALLBACKS=true

# Amazon Bedrock (LLM_PROVIDER=bedrock). Model must be a Bedrock inference-profile id.
LLM_MODEL=global.anthropic.claude-opus-5-5
AWS_REGION=ap-south-1
# Bedrock API key: export AWS_BEARER_TOKEN_BEDROCK in the shell that runs docker compose (it is passed
# through), or use standard AWS credentials instead. Avoid writing the key into this file.
# Client-side refusal fallback model (empty to disable)
BEDROCK_FALLBACK_MODEL=global.anthropic.claude-opus-4-8

# --- Task-based model routing ---
# Answers always use LLM_MODEL. Lighter tasks can use a smaller model; failures escalate to LLM_MODEL.
# Transcripts / OCR (the user reviews them): a Sonnet-class model is accurate enough and faster.
LLM_MODEL_TRANSCRIBE=global.anthropic.claude-sonnet-5-5
# Checking cut-out letters decides final handwriting quality and runs once per profile: keep it on LLM_MODEL.
#LLM_MODEL_VERIFY=
LLM_EFFORT_LIGHT=medium
# Medium effort for small questions (<= 3 marks or concise), LLM_EFFORT for the rest
LLM_ADAPTIVE_EFFORT=true
LLM_ESCALATE=true

# OpenAI-compatible server, e.g. Ollama (LLM_PROVIDER=openai_compatible)
#OPENAI_COMPAT_BASE_URL=http://ollama:11434/v1
#OPENAI_COMPAT_API_KEY=

# Cost estimates: USD per million tokens (needed for Bedrock / custom models)
#LLM_INPUT_PRICE_PER_MTOK=
#LLM_OUTPUT_PRICE_PER_MTOK=

# --- OCR for scanned PDFs: auto | tesseract | llm | none ---
OCR_PROVIDER=auto

# --- Frontend ---
# Where the Next.js server proxies /api (inside docker compose: http://api:8000)
BACKEND_URL=http://api:8000
